# J.U.N.E. Environment Configuration (Example)
# Copy to .env for local development. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=info

# Backend API Service
API_HOST=127.0.0.1
API_PORT=8000

# Optional BYOK (Bring-Your-Own-Key) LLM Providers (Leave blank for local offline)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

